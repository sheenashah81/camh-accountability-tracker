msgstr "No hay datos disponibles para este gráfico."

msgid "The chart could not be loaded. The data table below has the same values."
msgstr "No se pudo cargar el gráfico. La tabla de datos de abajo contiene los mismos valores."

msgid "Overview"
msgstr "Resumen"

msgid "Countries tracked"
msgstr "Países en seguimiento"

msgid "Starter countries chosen for this prototype"
msgstr "Países de partida elegidos para este prototipo"

msgid "Each one links to its public source"
msgstr "Cada uno enlaza con su fuente pública"

msgid "Records in preparation"
msgstr "Registros en preparación"

msgid "Drafts waiting for review, a licence check or a status assessment"
msgstr "Borradores a la espera de revisión, de comprobar la licencia o de evaluar el estado"

